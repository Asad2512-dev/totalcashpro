<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive folders/files from the web root.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)/ - [F,L,NC]
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|phpunit\.xml|package\.json|vite\.config\.js) - [F,L,NC]

    # If the request is not already inside /public, route everything there.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
